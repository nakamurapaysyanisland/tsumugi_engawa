<h1>投稿詳細</h1>

<%= image_tag @post.user.get_profile_image(10,10), size: "100x100" %>
<div>
  <strong>ユーザー:</strong>
  <%= link_to @post.user.nickname, user_path(@post.user) %>
</div>
<div>
  <strong>カテゴリー:</strong>
  <%= @post.category.name %>
</div>
<div>
  <strong>タイトル:</strong>
  <%= @post.title %>
</div>

<div>
  <strong>本文:</strong>
  <%= @post.body %>
</div>
<%= @post.created_at.strftime('%Y/%m/%d') %>
<div>
  <h5>コメント件数：<%= @post.post_comments.count %></h5>
  <% @post.post_comments.each do |post_comment| %>
    <%= image_tag post_comment.user.get_profile_image(10,10), size: "50x50" %>
    <div>
      <strong><%= post_comment.user.nickname %>:</strong>
      <%= post_comment.content %>
      <%= post_comment.created_at.strftime('%Y/%m/%d') %>
    </div>
  <% end %>
</div>
<div>
  <h5>コメントを投稿する</h5>
  <%= form_with model: [@post, @post_comment] do |f| %>
    <%= f.text_area :content, rows: 5, placeholder: "コメントを入力してください" %>
    <%= f.submit "投稿する" %>
  <% end %>
</div>
<% if user_signed_in? && @post.user_id == current_user.id %>
<%= link_to '編集', edit_post_path(@post) %>
<%= link_to '削除', post_path(@post), method: :delete, data: { confirm: "本当に削除しますか？" } %>
<% end %>
<%= link_to '一覧へ戻る', posts_path %>