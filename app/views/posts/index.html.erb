
      <% @posts.each do |post| %>
        
        
         <%= image_tag post.user.get_profile_image(100,100), size: "100x100" %>
        <div>
        <strong>ユーザー:</strong>
        <%= link_to post.user.nickname, user_path(post.user) %>
        </div>
        
        <div>
        <%= post.category.name %>
        </div>
        <div>
        <%= post.title %>
        </div>
        <div>
        <%= post.body %>
        </div>
        <%= post.created_at.strftime('%Y/%m/%d') %>
        <p><%= link_to "#{post.post_comments.count} コメント", post_path(post.id) %></p>
       



        <%= link_to "詳細", post_path(post) %>
     <% end %>