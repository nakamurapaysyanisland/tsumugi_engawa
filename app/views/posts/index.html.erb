
      <% @posts.each do |post| %>
        <div>
        <%= image_tag post.user.get_profile_image(10,10), size: "50x50" %>
         
        <%= post.user.nickname %>
        </div>
        <div>
        <%= post.category.name %>
        </div>
        <div>
        <%= post.title %>
        </div>
        <div>
        <%= post.body %>
        </div>
        <%= post.created_at.strftime('%Y/%m/%d') %>
       



        <%= link_to "詳細", post_path(post) %>
     <% end %>