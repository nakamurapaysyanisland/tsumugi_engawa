<div class="container">
  <div class="row">
    <div class="col">

    
<%= image_tag @user.get_profile_image(100,100), size: "100x100" %>
<div><%= @user.nickname %>    さんの投稿一覧</div>

 <% @posts.each do |post| %>
        <div><%= post.title %></div>
        <div><%= post.body %></div>
        <%= post.created_at.strftime('%Y/%m/%d') %>

        <%= link_to "詳細", post_path(post) %>
      
<% end %>
