<%= form_with model: @user do |f| %>
    
    <div>
        <% if @user.errors.any? %>
          <h5>
            プロフィールの編集に失敗しました。入力内容を確認してください。
          </h5>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
<h5>ユーザー編集画面</h5>



<div class="form-group">
  <%= f.label "姓" %>
  <%= f.text_field :last_name %>
  <%= f.label "名" %>
  <%= f.text_field :first_name %>
  </div>

  <div class="form-group">
  <%= f.label "ニックネーム" %>
  <%= f.text_field :nickname %>
  </div>

   <div class="form-group">
  <%= f.label "メールアドレス" %>
  <%= f.text_field :email %>
  </div>

   <div class="form-group">
  <%= f.label "パスワード" %>
  <%= f.text_field :password %>
  </div>
  
  <%= f.submit "更新" %>
  <% end %>