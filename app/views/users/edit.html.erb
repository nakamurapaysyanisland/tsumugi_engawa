<%= form_with model: @user do |f| %>
    
    <div>
        <% if @user.errors.any? %>
          <h5>
            プロフィールの編集に失敗しました。入力内容を確認してください。
          </h5>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
<h5>ユーザー編集画面</h5>
 <div class="form-group">
      <%= f.label :image, class: "image-upload-label" do %>
    <div class="image-upload-frame">
      <i class="fas fa-camera"></i> <p>画像を選択してください</p>
      <%= f.file_field :image, accept: "image/*", class: "hidden-file-input" %>
    </div>
  <% end %>
 </div>
<% t("enums.user.status.#{@user.status}") %>
<div class="form-group">
  <%= f.label "ニックネーム" %>
  <%= f.text_field :nickname %>
</div>

<% unless current_user.guest?%>
<div class="form-group">
  <%= f.label "姓" %>
  <%= f.text_field :last_name %>
  <%= f.label "名" %>
  <%= f.text_field :first_name %>
  </div>

  

   <div class="form-group">
  <%= f.label "メールアドレス" %>
  <%= f.text_field :email %>
  </div>

   <div class="form-group">
  <%= f.label "パスワード" %>
  <%= f.text_field :password %>
  </div>
  <% end %>
  <%= f.submit "更新" %>
  <% end %>

  <% unless current_user.guest?%>
  <h3>退会について</h3>
<p>退会するとマイページにログインできなくなります。</p>

<%= link_to "退会する", withdraw_user_path(@user), 
            method: :patch, data: { confirm: "本当に退会しますか？" }, class: "btn-delete" %>
<% end %>
