<div class="d-flex align-items-start mb-3">
  
  <div class="me-2">
    <% if user_signed_in? %>
      <%= image_tag current_user.get_profile_image(40,40), size: "40x40", class: "rounded-circle border mr-2" %>
    <% else %>
      <%= image_tag 'no_image.jpg', size: "40x40", class: "rounded-circle border" %>
    <% end %>
  </div>

  <%= form_with model: [post, post_comment], local: false, class: "d-flex align-items-center flex-grow-1" do |f| %>
    
  
    <%= f.text_area :content, rows: 1, placeholder: "コメントを入力...", class: "form-control mr-2" %>
    
    
    <%= f.submit "投稿" %>
    
  <% end %>
</div>