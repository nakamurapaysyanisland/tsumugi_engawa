<% post.post_comments.order(created_at: :desc).each do |post_comment| %>

  <div id="comment_<%= post_comment.id %>" class="border-bottom py-3" style="color: #4a463f;">
    
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="d-flex align-items-center">   
        <%= image_tag post_comment.user.get_profile_image(40,40), size: "40x40", class: "rounded-circle border mr-2" %>
        <strong class="small">
          <%= link_to user_path(post_comment.user) do %>
            <%= post_comment.user.nickname %>
          <% end %>
        </strong>
      </div>
      
  
      <% if user_signed_in? && post_comment.user_id == current_user.id %>
        <div class="dropdown">
        <button class="btn btn-sm text-secondary p-0" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="box-shadow: none;">
          <i class="fas fa-ellipsis-h"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-right shadow-sm" aria-labelledby="dropdownMenuButton" style="min-width: 80px;">
          <%= link_to "削除", post_post_comment_path(post, post_comment), method: :delete, remote: true, data: { confirm: "本当に削除しますか？" }, class: "dropdown-item small text-danger" %>
        </div>
        </div>
      <% end %>
    </div>
 
    <p class="small mb-2" style="line-height: 1.5;">
      <%= post_comment.content %>
    </p>

    <div class="text-secondary" style="font-size: 0.75rem;">
      <%= time_ago_in_words(post_comment.created_at) %>
    </div>
  </div> 
<% end %>