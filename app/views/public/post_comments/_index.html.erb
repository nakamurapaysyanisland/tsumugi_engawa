<% post.post_comments.each do |post_comment| %>
  <div class="d-flex flex-row align-items-center justify-content-center mt-auto border-top border-bottom py-2", style="color: #4a463f;">
    <div class="flex-grow-1 justify-content-center">
      <div class="d-flex justify-content-between">
        <div class="d-flex align-items-center">   
          <%= image_tag post_comment.user.get_profile_image(10,10), size: "40x40", class: "rounded-circle border mr-1" %>
          <strong><%= post_comment.user.nickname %></strong>
        </div>
        <div>
          <% if post_comment.user == current_user %>
            <div class="dropdown">
              <button class="btn btn-sm text-secondary p-0" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="box-shadow: none;">
               <i class="fas fa-ellipsis-h"></i>
              </button>
              <div class="dropdown-menu dropdown-menu-right shadow-sm" aria-labelledby="dropdownMenuButton", style="min-width: auto;">
                <%= link_to post_post_comment_path(post, post_comment), method: :delete, remote: true, data: { confirm: "本当に削除しますか？" }, class: "dropdown-item small text-danger" do %>
                  削除
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <p class="text-muted small mt-2">
        <%= post_comment.content %>
      </p>
      <div class="mt-auto pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center small">
      
          <%= time_ago_in_words(post_comment.created_at) %>前
              
        </div>
      </div>
    </div>
  </div> 
<% end %>