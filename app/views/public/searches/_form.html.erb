
<%= form_with url: search_path, method: :get, local: true do |f| %>
  <div class="d-flex flex-row",style: "color: #4a463f;">
    <%= f.text_field :content, class: "form-control mr-1", placeholder: "キーワードを入力" %>
    <%= f.select :model, options_for_select({"投稿" => "post", "ユーザー" => "user"}), {}, {class: "form-select mx-1"} %> 
    <%= f.hidden_field :method, value: "partial" %>
    <%= f.submit "検索" %>
  </div>
  <% end %>