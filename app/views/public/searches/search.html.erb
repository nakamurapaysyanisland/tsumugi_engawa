 <div class="container">
  <div class="row justify-content-center">
    <div class="col-md-12 col-sm-12">
      <div class="d-flex align-text-center justify-content-center w-100 my-5">
        <%= render 'public/searches/form', posts: @posts %>
      </div>
     
      <div class="d-flex flex-column justify-content-center align-text-center fw-bold">
        <% if @model == 'user' %>
	        <h3 class="text-center">「<%= @content %>」の検索結果
          <span class="small">(<%= @users.total_count %>件)</span></h3>
            <%= render 'public/users/index' %>
        <% elsif @model == 'post' || @model == 'tag' %>
	          <div><h3 class="text-center">「<%= @content %>」の検索結果
             <span class="small">(<%= @posts.total_count %>件)</span></h3>
          <%= render 'public/posts/index', posts: @posts %>
        <% end %>
      </div>
      <div class="d-flex flex-column justify-content-center"> 
        <div class="text-center mb-3 mt-4">
          <h4 class="fw-bold" style="color: #4a463f;">カテゴリーから探す</h4>
        </div>
        <div class="row justify-content-center">
        <% @categories.each do |category| %>
        <div class="col-6 col-md-4 mb-3"> 
          <%= link_to posts_path(category_id: category.id), class: "text-decoration-none w-100" do %>
              <div class="p-3 shadow-sm rounded border h-100 d-flex flex-column align-items-center justify-content-center" style="background-color: #fcfaf2; min-height: 80px;">
                <span class="h5 mb-0" style="color: #4a463f;"><%= category.name %></span>
              </div>
          <% end %>
        </div>
        <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
