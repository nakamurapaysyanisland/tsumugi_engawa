<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-12 col-sm-11">
            <div class="d-flex flex-column align-items-center justify-content-center w-100">
                <h2 class="fw-bold mb-4" style="color: #4a463f;">- 承認待ち一覧 -</h2>
                  <h4 class="fw-bold mb-4" style="color: #4a463f;">「 <%= @group.name %> 」</h4>
                    <% if @group_users.present? %>
                    <table class="table table-bordered table-hover text-center" style="background-color: #fcfaf2;">
                        <thead>
                            <tr>
                                <th>ユーザー名</th>
                                <th>申請日時</th>
                                <th>投稿数</th>
                                <th></th>
                            </tr>
                        </thead>
                    <tbody>
                      <% @group_users.each do |group_user| %>
                        <tr>
                          <td width="20%" class="text-center align-middle">
                            <%= image_tag group_user.user.get_profile_image(100,100), size: "40x40", class: "rounded-circle border small mr-2" %>
                            <%= link_to group_user.user.nickname, user_path(@group, group_user), class: "text-dark" %>
                          </td>
                          <td width="20%" class="text-center align-middle"><%= group_user.created_at.strftime('%Y年%m月%d日%H時%M分') %></td>
                          <td width="10%" class="text-center align-middle"><%= group_user.user.posts.count %>件</td>
                          <td width="20%" class="text-right text-center align-middle">
                            <%= link_to '加入許可', group_group_user_path(@group, group_user), method: :patch, class: "btn btn-sm btn-outline-success text-success" %> |
                            <%= link_to '加入見送り', group_group_user_path(@group, group_user), method: :delete, class: "btn btn-sm btn-outline-danger text-danger" %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                    </table>
                    <% else %>
                      <P class="text-center">承認待ちユーザーはいません。</P>
                    <% end %>
            </div>
              <div class="mx-auto mt-5">
                <%= paginate @group_users %></div>
              </div>
              <div class="col-md-9 mx-auto">
                <p class="text-center"><%= link_to "戻る", group_path(@group), class: 'text-dark font-weight-bold' %></p>
              </div>
        </div>
      </div>
</div>
