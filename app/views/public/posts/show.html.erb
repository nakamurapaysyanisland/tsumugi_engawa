<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      
      <div class="card shadow-sm border-0 p-4 mb-4" style="background-color: #fcfaf2;">
        <%= render 'public/posts/post_card', post: @post %>

        <div class="mt-4 pt-4" style="border-top: 3px double #868e96;">
          <div class="comment-form mb-4">
            <%= render 'public/post_comments/form', post: @post, post_comment: @post_comment %>
          </div>

          <div id="comment_index_<%= @post.id %>">
            <%= render 'public/post_comments/index', post: @post %>
          </div>
        </div>

        
        <div class="d-flex justify-content-end mt-4">
          <%= link_to '一覧へ', posts_path, class: "btn btn-outline-secondary btn-sm" %>
        </div>
      </div>

    </div>
  </div>
</div>