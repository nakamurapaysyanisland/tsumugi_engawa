<table class='table'>
  <thead>
    <tr>
      <th>image</th>
      <th>name</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= image_tag post.user.get_profile_image(100,100), size: '50x50' %></td>
        <td><%= post.user.nickname %></td>
        <td><%= post.title %></td>
        <td><%= post.body%></td>
        <td><%= link_to 'Show', post, class: "post_#{post.id}" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
