<table class='table'>
  <thead>
    <tr>
      <th>image</th>
      <th>name</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <% if user_signed_in? %>
  <%= image_tag current_user.get_profile_image(40,40), class: "rounded-circle" %>
<% else %>
  <%= image_tag 'no_image.jpg', class: "rounded-circle" %>
<% end %>
        <td><%= post.user.nickname %></td>
        <td><%= post.title %></td>
        <td><%= post.body%></td>
        <td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to 'Show', post, class: "post_#{post.id}" %></td>