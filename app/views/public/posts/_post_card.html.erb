<div class="d-flex align-items-center justify-content-between mb-3">

  <div class="d-flex align-items-center">
    <%= image_tag post.user.get_profile_image(40,40), size: "40x40", class: "rounded-circle border" %>
    <span class="font-weight-bold text-dark ml-2">
      <%= post.user.nickname %>
    </span>
  </div>
  

  <div class="d-flex align-items-center">
    <% if post.category.present? %>
      <div class="mr-1 bg-white p-1 small rounded border text-secondary">
        <%= post.category.name %>
      </div>
    <% end %>
    <% if post.group.present? %>
      <div class="mr-1 bg-white p-1 small rounded border text-secondary">
        <i class="fas fa-users mr-1"></i><%= truncate(post.group.name, length: 10) %>
      </div>
    <% end %>
    <% if post.user == current_user %>
      <%= link_to "削除", post_path(post), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "small text-danger ml-2 text-decoration-none" %>
    <% end %>
  </div>
</div>

<div class="h5 fw-bold mb-2" style="color: #4a463f;">
  「<%= post.title %>」
</div>


<div class="text-muted small mb-3">
  <%= post.body %>
</div>


<div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3 small text-secondary">
  <span><%= time_ago_in_words(post.created_at) %>前</span>
  <div class="d-flex align-items-center">
  
    <div class="mr-3"> 
      <i class="far fa-comment"></i> <%= post.post_comments.count %>
    </div>

    <%= render 'public/favorites/favorite', post: post %>
  </div>
</div>