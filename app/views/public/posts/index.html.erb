<div class="container my-4"> <div class="row justify-content-center">
    <div class="col-md-12"> 
    <h3 class="fw-bold d-flex align-items-center justify-content-center mb-3">
  <%= @category ? "「#{@category.name}」の投稿一覧" : "すべての投稿一覧" %>
</h3>
<div class="row mt-2"> 
<% @posts.each do |post| %>
  <div class="col-md-4 mb-2">
  <div class="rounded border h-100 p-4 d-flex flex-column" style="background-color: #fcfaf2;">
  <%= render 'public/posts/post_card', post: post %>
  </div>
  </div>
  <% end %>
  </div>
      <div class="d-flex justify-content-center mt-5">
        <%= paginate @posts %>
      </div>
    </div>
  </div>
</div>