<div class="container my-4"> <div class="row justify-content-center">
    <div class="col-md-12"> <div class="row"> <% @posts.each do |post| %>
          <div class="col-md-4 mb-2"> 
            <div class="rounded border h-100 p-4 d-flex flex-column" style="background-color: #fcfaf2;">
              
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center">
                  <%= image_tag post.user.get_profile_image(40,40), size: "40x40", class: "rounded-circle border" %>
                  <%= link_to post.user.nickname, user_path(post.user), class: "text-decoration-none text-dark ms-2 small" %>
                </div>
                <div class="bg-white px-2 py-1 small rounded border text-muted">
                  <%= post.category.name %>
                </div>
              </div>

              <%= link_to post_path(post), class: "text-decoration-none text-dark" do %>
                <div class="mb-3">
                  <div class="h5 fw-bold mb-2"><%= post.title %></div>
                  <div class="text-muted small">
                    <%= post.body %>
                  </div>
                </div>
              <% end %>

              <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3 small text-secondary">
                <span><%= post.created_at.strftime('%Y/%m/%d') %></span>
                <%= link_to post_path(post), class: "text-decoration-none text-secondary" do %>
                   <i class="far fa-comment"></i> <%= post.post_comments.count %>
                <% end %>
              </div>

            </div>
          </div>
        <% end %>
      </div>

      <div class="d-flex justify-content-center mt-5">
        <%= paginate @posts %>
      </div>

    </div>
  </div>
</div>