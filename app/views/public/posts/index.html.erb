<% if @category %>
  <% breadcrumb :category_posts, @category %>
<% else %>
  <% breadcrumb :posts %>
<% end %>

<div class="container my-5">
  <div class="text-center mb-5">
    <h3 class="fw-bold">
      <%= @category ? "-「#{@category.name}」の投稿一覧 - (#{@category.posts.count}件)" : "- すべての投稿 -" %>
    </h3>
  </div>
  
  
  <div class="row justify-content-center">
    <% @posts.each do |post| %>
     
      <div id="post_<%= post.id %>" class="col-md-4 col-sm-6 mb-4">
        <div class="card h-100 shadow border-0 p-3" style="background-color: #fcfaf2;">
          <%= render 'public/posts/post_card', post: post %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-5">
    <%= paginate @posts %>
  </div>
</div>