 <div class="container">
  <div class="row justify-content-center">
    <div class="col-md-10 col-sm-11 ">
      <div class="justify-content-center ">
        <%= render 'public/searches/form', posts: @posts %>
      </div>



      <div class="text-center">
      <h4 class="fw-bold" style="color: #4a463f;">カテゴリーから探す</h4>
      </div>
 
      <div class="row justify-content-center"> 

    <% @categories.each do |category| %>
    <div class="col-6 col-md-4"> 
      
      <%= link_to category_path(category), class: "text-decoration-none h-100" do %>
          <div class="p-3 shadow-sm rounded border text-center h-100 mb-3" style="background-color: #fcfaf2;">
          <div class="category-name h5 text-dark mb-0">
            <%= category.name %>
          </div>
        </div>
      <% end %>
    
    </div>
    <% end %>
  </div>
    </div>
  </div>
</div>
