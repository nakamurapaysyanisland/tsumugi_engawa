 <div class="container">
  <div class="row justify-content-center">
    <div class="col-md-10 col-sm-11 ">
      <div class="d-flex align-text-center justify-content-center w-100 my-5">
        <%= render 'public/searches/form', posts: @posts %>
      </div>



      <div class="text-center mb-3">
        <h4 class="fw-bold" style="color: #4a463f;">カテゴリーから探す</h4>
      </div>
 
      <div class="row justify-content-center"> 

    <% @categories.each do |category| %>
    <div class="col-6 col-md-4 mb-3"> 
      
      <%= link_to category_path(category), class: "text-decoration-none h-100" do %>
          
          <div class="p-3 shadow-sm rounded border h-100 d-flex align-item-center justify-content-center" style="background-color: #fcfaf2;">
          <div class="category-name h5 ", style="color: #4a463f;">
            <%= category.name %>
          </div>
        </div>
      <% end %>
    
    </div>
    <% end %>
  </div>
    </div>
  </div>
</div>
