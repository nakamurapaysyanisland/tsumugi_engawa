<div id="favorite_buttons_<%= post.id %>">
  <% if user_signed_in? %>
    <% if post.favorited_by?(current_user) %>
      <%= link_to post_favorites_path(post), method: :delete, remote: true, class: "text-danger text-decoration-none" do %>
        <i class="fa-solid fa-heart"></i> <%= post.favorites.count %>
      <% end %>
    <% else %>
      <%= link_to post_favorites_path(post), method: :post, remote: true, class: "text-secondary text-decoration-none" do %>
        <i class="fa-regular fa-heart"></i> <%= post.favorites.count %>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, onclick: "alert('いいねするにはログインが必要です')", class: "text-secondary text-decoration-none" do %>  
      <i class="fa-regular fa-heart"></i> <%= post.favorites.count %>
    <% end %>
  <% end %>
</div>