<div class="container">
  <div class="row">
    <div class="col-md-11 col-sm-12 d-flex flex-column justify-content-center align-items-center">
      <div class="d-flex">
      <%= image_tag @user.get_profile_image(100,100), size: "100x100" %>
      <div>ニックネーム：  <%= @user.nickname %>    さん。</div>
      <div>ステータス：  <%= t(@user.status, scope: 'enums.user.status') %></div>
      <div>登録日：  <%= @user.created_at.strftime('%Y/%m/%d') %></div>
      <%= link_to edit_user_path(@user) do %>
        <i class="fa-solid fa-user">プロフィール</i>
      <% end %>
      <div>投稿件数：<%= @posts.count%></div>
      <% t("enums.user.status.#{@user.status}") %>
   </div>
    
   <div class="row">
      <div class="col-md-11 col-sm-12">
        <div class="d-flex flex-column align-items-center">
          <h4 class="h4">投稿一覧</h4>
        </div>
      </div>
    </div>
      <div class="row"> 
       <% @posts.each do |post| %>
        
      <div class="col-md-6 col-sm-12 h-100 shadow-sm rounded border bg-white p-3 mb-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <%= image_tag post.user.get_profile_image(100,100), size: "40x40"%>
              <%= link_to post.user.nickname, user_path(post.user), class: "text-decoration-none fw-bold text-dark ms-2 border-bottom border-dark m-2" %>
            </div>
            <div class="rounded small border bg-light p-1">
              <%= post.category.name %>
            </div>
          </div>
          <%= link_to post_path(post), class: "text-decoration-none text-dark" do %>
        <div><%= post.title %></div>
        <div><%= post.body %></div>
        <%= post.created_at.strftime('%Y/%m/%d') %>
          <p><%= link_to "#{post.post_comments.count} コメント", post_path(post.id) %></p>
          <% end %>
        <div class="d-flex justify-content-end">
          <%= link_to "編集", edit_post_path(post) %>
          <%= link_to "削除", post_path(post), method: :delete, data: { confirm: "本当に削除しますか？" } %>
        </div>

    </div>
      <% end %>
      </div>
  
</div>
