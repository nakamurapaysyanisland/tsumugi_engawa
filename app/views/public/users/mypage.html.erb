<div class="container my-5">
  <div class="row justify-content-center mb-4">
    <div class="col-md-10 col-lg-8">
      <div class="px-4 pt-4 pb-4 rounded border-bottom text-center">
        <div class="mb-3">
          <%= image_tag @user.get_profile_image(100,100), size: "100x100", class: "rounded-circle border" %>
        </div>
        <h4 class="fw-bold"><%= @user.nickname %>さん</small></h4>
        
        <div class="d-flex justify-content-center my-3 small text-secondary">
          <span class="mx-3">ステータス：<%= t(@user.status, scope: 'enums.user.status') %></span>
          <span class="mx-3">登録日：<%= @user.created_at.strftime('%Y/%m/%d') %></span>
          <span class="mx-3">投稿件数：<%= @posts.count %>件</span>
        </div>

        <%= link_to edit_user_path(@user), class: "btn btn-outline-secondary btn-sm rounded-pill px-4" do %>
          <i class="fa-solid fa-user me-1"></i>プロフィール編集
        <% end %>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12 text-center">
      <h4 class="fw-bold" style="color: #4a463f;">投稿一覧</h4>
    </div>
  </div>

  <div class="row"> <% @posts.each do |post| %>
      <div class="col-md-4 mb-2">
        <div class="rounded border h-100 p-4 d-flex flex-column" style="background-color: #fcfaf2;">
          
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center">
              <%= image_tag post.user.get_profile_image(40,40), size: "40x40", class: "rounded-circle border-sm mr-2" %>
              <strong><%= link_to post.user.nickname, user_path(post.user), class: "text-decoration-none text-dark small" %></strong>
            </div>
            <div>
                <%= link_to post.category.name, posts_path(category_id: post.category_id), class: "bg-white p-1 small rounded border text-muted" %>
                </div>
          </div>

          <%= link_to post_path(post), class: "text-decoration-none text-dark" do %>
            <div class="mb-3">
              <div class="h5 fw-bold mb-2"><%= post.title %></div>
              <p class="text-muted small">
                <%= post.body %>
              </p>
            </div>
          <% end %>

          <div class="mt-auto pt-2 border-top">
            <div class="d-flex justify-content-between align-items-center small text-secondary">
              <div>
                <span class="me-3"><%= post.created_at.strftime('%Y/%m/%d') %></span>
                <%= link_to post_path(post), class: "text-decoration-none text-secondary" do %>
                  <i class="far fa-comment"></i> <%= post.post_comments.count %>
                <% end %>
              </div>

              <div class="d-flex">
                <%= link_to '編集', edit_post_path(post), class: "btn btn-sm text-decoration-none mr-1", style: "color: #314a33; border: 1px solid #314a33;" %>
                <%= link_to '削除', post_path(post), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-sm text-decoration-none", style: "color: #b24a4a; border: 1px solid #b24a4a; background-color: transparent;" %>
              </div>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-5">
    <%= paginate @posts %>
  </div>
</div>