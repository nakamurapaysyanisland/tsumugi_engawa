<div class="container my-5">
  <div class="row justify-content-center mb-2">
    <div class="col-md-10 col-lg-8">
      <div class="p-4 rounded border-bottom text-center">
        <div class="mb-3">
          <%= image_tag @user.get_profile_image(100,100), size: "100x100", class: "rounded-circle border" %>
        </div>
        <h4 class="fw-bold"><%= @user.nickname %>さんのページ</small></h4>
      </div>
    </div>
  </div>
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h4 class="fw-bold" style="color: #4a463f;">投稿一覧</h4>
    </div>
  </div>

      <div class="row"> 
      <% @posts.each do |post| %>
      <div class="col-md-4 mb-2">
      <div class="rounded border h-100 p-4 d-flex flex-column" style="background-color: #fcfaf2;">
         
      <%= render 'public/posts/post_card', post: post %>
      </div>
      </div>
    <% end %>
  </div>
        
  <div class="d-flex justify-content-center mt-5">
    <%= paginate @posts %>
  </div>
</div>