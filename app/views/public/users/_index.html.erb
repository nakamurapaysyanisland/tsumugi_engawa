<div class="container my-4 border-bottom"> 
    <div class="row justify-content-center">
        <div class="col-md-12"> 
            <div class="row justify-content-center mt-2">
                <% if users.blank? %>
                        <p class="h6 mt-3">該当するユーザーはいませんでした。</p>
                    <% else %>
                        <% users.each do |user| %>
                        <div class="col-md-3 my-2">
                            <div class="rounded border h-100 d-flex flex-column" style="background-color: #fcfaf2;">
                                <div class="d-flex align-items-center justify-content-center py-3 px-4">
                                    
                                    <%= image_tag user.get_profile_image(60,60), size: "60x60", class: "rounded-circle border" %>
                                    <div class="d-flex flex-column ml-3"> 
                                    <%= link_to user.nickname, user_path(user), class: "font-weight-bold text-decoration-none text-dark ml-2" %>
                                    <span class="small text-secondary">投稿件数：<%= user.posts.count %>件</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% end %>
                <% end %>
            </div>
            <div class="d-flex justify-content-center mt-5">
                <%= paginate @users %>
            </div>
        </div>
    </div>
</div>