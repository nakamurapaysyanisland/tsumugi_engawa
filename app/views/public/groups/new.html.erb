<div class="container">
  <div class="row justify-content-center">
    <div class="d-flex flex-column align-items-center justify-content-center w-100">
      <div class="col-md-5 col-sm-11">
        <div class="d-flex flex-column align-items-center justify-content-center w-100">
          <h2 class="fw-bold mt-5" style="color: #4a463f;">新しいグループを作成</h2>
          <%= form_with model: @group, local: true, class: 'w-100' do |f| %>
          <div class="d-flex flex-column mt-3">
          <div class="field text-center">
            <label for="file-input" style="cursor: pointer; margin: 0 auto; display: block; width: 100px;">
                <div id="img_field" class="rounded-circle border d-flex align-items-center justify-content-center" 
                style="width: 100px; height: 100px; background-color: #f8f9fa; overflow: hidden; position: relative;">
                    <img src="" id="preview" style="display: none; width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 10;">
                        <div id="inner-content">
                            <i class="fa-solid fa-camera fa-3x" style="color: #4a463f;"></i>
                            <p id="placeholder" style="margin: 0; line-height: 1.2; padding: 0 5px;"></p>
                        </div>
                </div>
                <%= f.file_field :group_image, id: "file-input", accept: "image/*", class: "d-none" %>
            </label>
          </div>

<div class="d-flex flex-column my-1" style="color: #4a463f;"> 
<%= f.label :name, 'コミュニティ名' %>
<%= f.text_field :name, rows: 2, class: "form-control" %>
<% if @group.errors.include?(:name) %>
<div class="text-danger small mt-1 fw-bold">
<i class="fa-solid fa-circle-exclamation"></i>
<%= @group.errors.full_messages_for(:name).first %>
</div>
<% end %>
</div>

<div class="d-flex flex-column my-1" style="color: #4a463f;"> 
<%= f.label :introduction, 'グループ概要' %>
<%= f.text_area :introduction, rows: 4, class: "form-control" %>
<% if @group.errors.include?(:introduction) %>
<div class="text-danger small mt-1 fw-bold">
<i class="fa-solid fa-circle-exclamation"></i>
<%= @group.errors.full_messages_for(:introduction).first %>
</div>
<% end %>
</div>
<div class="my-3" style= "color: #4a463f;">
<%= f.submit '作成', class: "w-100" %>
</div>
<% end %>   
        </div>
      </div>
    </div>
  </div>
</div>

<script>

  document.getElementById('file-input').addEventListener('change', function(e) {
    const file = e.target.files[0]; 
    const preview = document.getElementById('preview'); 
    const innerContent = document.getElementById('inner-content'); 

    if (file) {
      const reader = new FileReader(); 
      reader.onload = function(e) {
        preview.src = e.target.result;
        preview.style.display = 'block'; 
        innerContent.style.display = 'none'; 
      }
      reader.readAsDataURL(file); 
    }
  });
</script>