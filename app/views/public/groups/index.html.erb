<% breadcrumb :groups %>
<div class="container my-5">
  <div class="text-center mb-5">
    <h3 class="fw-bold" style="color: #4a463f;">- コミュニティ -</h3>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-10 mb-5 text-center">
      <%= link_to new_group_path, class: "btn btn-outline-secondary w-50" do %>
        <i class="fa-solid fa-people-group me-2"></i>
        <span>新しいコミュニティを立ち上げる</span>
      <% end %>
    </div>

    <% @groups.each do |group| %>
      <div class="col-md-4 col-sm-8 mb-4">
        <div class="card h-100 shadow-sm border-0 p-3" style="background-color: #fcfaf2;">
          <%= render 'public/groups/group_card', group: group %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-5">
    <%= paginate @groups %>
  </div>
</div>