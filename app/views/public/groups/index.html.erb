<div class="container my-5">
  <div class="text-center mb-5">
    <h2 class="fw-bold" style="color: #4a463f;">コミュニティ</h2>
    <p class="text-secondary">同じ悩みや目標を持つ仲間とつながる場所です</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-10 mb-5">
      <%= link_to new_group_path, class: "text-decoration-none" do %>
        <div class="p-4 shadow-sm rounded border d-flex align-items-center justify-content-center bg-white" 
             style="border: 2px dashed #d1c9b8 !important; transition: 0.3s;">
          <i class="fas fa-plus-circle fa-2x me-3" style="color: #d1c9b8;"></i>
          <span class="h5 mb-0 fw-bold text-dark">新しいコミュニティを立ち上げる</span>
        </div>
      <% end %>
    </div>

    <% @groups.each do |group| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0" style="background-color: #fcfaf2;">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <%= image_tag 'no_image.jpg', size: "50x50", class: "rounded-circle border me-3" %>
              <h5 class="card-title fw-bold mb-0"><%= group.name %></h5>
            </div>
            <p class="card-text small text-secondary">
              <%= truncate(group.introduction, length: 60) %>
            </p>
          </div>
          <div class="card-footer bg-transparent border-0 text-end pb-3">
            #<%= link_to '詳細を見る', groups_path, class: "btn btn-sm btn-outline-dark rounded-pill px-3" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>