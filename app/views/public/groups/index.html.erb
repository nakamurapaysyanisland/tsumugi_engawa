<div class="container my-5">
  <div class="text-center mb-5">
    <h3 class="fw-bold" style="color: #4a463f;">コミュニティ</h3>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-10 mb-5">
      <%= link_to new_group_path, class: "text-decoration-none d-block w-75 mx-auto" do %>
        <div class="d-flex align-items-center justify-content-center">
          <i class="fa-solid fa-people-group"></i>
          <span>新しいコミュニティを立ち上げる</span>
        </div>
      <% end %>
    </div>
    <%= rendr 'public/groups/group_card', group: @group %>
  </div>
</div>
