<div>
  <% group_user = group.group_users.find_by(user_id: current_user.id) %>
    <% if group.owner_id == current_user.id %>
      <span>あなたは管理者です</span>
      <% elsif group_user&.accepted? %>
        <%= link_to 'グループ退出', group_group_user_path(group, group_user), method: :delete, remote: true, class: "btn btn-sm btn-outline-secondary", style: "background-color: #f2dede;", data: {confirm: "本当にグループを退出しますか？"} %>
      <% elsif group_user&.pending? %>
        <%= link_to '申請取消', group_group_user_path(group, group_user), method: :delete, remote: true, class: "btn btn-sm btn-outline-secondary", style: "background-color: #e0e0e0;" %>
      <% else %>
        <%= link_to '参加申請', group_group_users_path(group), method: :post, remote: true, class: "btn btn-sm btn-outline-secondary", style: "background-color: #d4edda;" %>
    <% end %>
</div>
