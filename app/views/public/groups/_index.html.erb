<div class="container my-4 border-bottom"> <div class="row justify-content-center">
    <div class="col-md-12"> 
   
<div class="row mt-2 justify-content-center"> 
<% if groups.blank? %>

               <p class="h6 mt-3">該当するコミュニティはありませんでした。</p>
               
              <% else %>
<% groups.order(created_at: :desc).each do |group| %>
  <div class="col-md-4 mb-2">
  <div class="rounded border h-100 p-4 d-flex flex-column" style="background-color: #fcfaf2;">
  <%= render 'public/groups/group_card', group: group %>
  </div>
  </div>
  <% end %>
  <% end %>
  </div>
      <div class="d-flex justify-content-center mt-5">
        <%= paginate groups %>
      </div>
    </div>
  </div>
</div>