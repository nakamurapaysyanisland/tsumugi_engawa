<div class="container my-5">
  <div class="row"> 
   
    <div class="col-md-4">
      <%= render 'public/groups/sidebar', group: @group %>
    </div>

    <div class="col-md-8 col-lg-8">
      <div class="px-4 pt-4 pb-4">
        <div class="mt-2">

          <% if @posts.present? %>
            
            <% @posts.each do |post| %> 
              <div class="p-4 d-flex flex-column mb-4" style="background-color: #fcfaf2; border-radius: 15px; border: 1px solid #e0d9c1;">
                
                <% if @group.is_member?(current_user) || @group.owner_id == current_user.id %>
              
                  <%= render 'public/posts/post_card', post: post %>
                  <div class="ml-3 mt-2">
                    <button class="btn btn-link btn-sm text-secondary text-decoration-none p-0" type="button" data-toggle="collapse" data-target="#collapseComments<%= post.id %>">
                      コメント（<%= post.post_comments.count %>件）を表示
                    </button>
                    <div class="collapse" id="collapseComments<%= post.id %>">
                      <div class="pt-3 border-top" style="border-color: #e0d9c1 !important;">
                        <%= render 'public/post_comments/form', post: post, post_comment: @post_comment %>
                        <div id="comment_index_<%= post.id %>" class="mb-2">
                          <%= render 'public/post_comments/index', post: post %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="text-center py-5 rounded shadow-sm border">
                    <p class="small text-secondary px-3">
                      <i class="fa-solid fa-lock"></i><br>
                      この投稿はコミュニティメンバー限定です。
                    </p>
                  </div>
                <% end %>

              </div> 
            <% end %> 

          <% else %>
            <div class="text-center py-5 border rounded bg-light shadow-sm">
              <h5 class="text-secondary">まだ投稿がありません</h5>
            </div>
          <% end %> 
        </div> 
      </div> 

      <% if @posts.present? %>
        <div class="d-flex justify-content-center mt-5">
          <%= paginate @posts %>
        </div>
      <% end %>

    </div> 
  </div>
</div> 