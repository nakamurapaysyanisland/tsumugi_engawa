<div class="container my-5">
  <div class="row"> <div class="col-md-4">
      <%= render 'public/groups/sidebar', group: @group %>
    </div>

<div class="col-md-8">
  <% is_accessible = @group.is_owned_by?(current_user) || @group.includes_user?(current_user) %>

  <div class="mt-2">
    <% @posts.each do |post| %> 
      <div class="p-4 mb-4 shadow-sm rounded" style="background-color: #fcfaf2; border: 1px solid #e9e4d6;">
        
        <% if is_accessible %>
          <%= render 'public/posts/post_card', post: post %>
          
          <div class="mt-3"> 
            <button class="btn btn-link btn-sm text-secondary text-decoration-none p-0 mb-2" type="button" data-toggle="collapse" data-target="#collapseComments<%= post.id %>">
              <i class="far fa-comment"></i> コメント（<%= post.post_comments.count %>件）を表示
            </button>

            <div class="collapse" id="collapseComments<%= post.id %>">
              <div class="card p-3 mb-3 border-0" style="background-color: #ffffff; border-radius: 10px;">
                <div class="comment-form mb-3">
                  <%= render 'public/post_comments/form', post: post, post_comment: @post_comment %>
                </div>
                <div id="comment_index_<%= post.id %>">
                  <%= render 'public/post_comments/index', post: post %>
                </div>
              </div> 
            </div> 
          </div>

        <% else %>

          <div class="text-center py-5">
            <i class="fa-solid fa-lock mb-3" style="color: #8c7e6d; font-size: 2rem; opacity: 0.5;"></i>
            <h6 class="fw-bold" style="color: #4a463f;">
              グループに参加すると<br>投稿やコメントができます
            </h6>
          </div>
        <% end %>

      </div> 
    <% end %> 
  </div>

  <div class="d-flex justify-content-center mt-5">
    <%= paginate @posts %>
  </div>
</div>