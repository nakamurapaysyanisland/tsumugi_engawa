<div class="card shadow-sm border-0 mb-4" style="background-color: #fcfaf2;">
  <div class="card-body text-center p-4">
    <div class="mb-3">
      <%= image_tag group.get_group_image(100,100), size: "100x100", class: "rounded-circle border shadow-sm" %>
    </div>
    <h5 class="fw-bold mb-2" style="color: #4a463f;"><%= group.name %></h5>
    <p class="text-muted small mb-3"><%= group.introduction %></p>

    <hr class="my-3" style="border-top: 1px dashed #d1c9bc;">

    <div class="text-secondary small mb-4">
      <div class="mb-1"><i class="fa-solid fa-user-shield me-1"></i> 管理者：<%= group.owner.nickname %></div>
      <div class="mb-1"><i class="fa-solid fa-users me-1"></i> メンバー：<%= group.users.count %>名</div>
    </div>

    <% if @group.owner_id == current_user.id %>
          <div class="dropdown mb-3">
            <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              オーナー専用
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdownMenu1">
              <%= link_to "承認待ち一覧", group_group_users_path(@group), class: "dropdown-item bg-transparent" %>
              <%= link_to "グループ編集", edit_group_path(@group), class: "dropdown-item bg-transparent" %>
              <%= link_to "グループ削除", group_path(@group), method: :delete, class: "dropdown-item bg-transparent text-danger", data: { confirm: "本当に削除しますか？" } %>
            </div>
          </div>
        <% end %>
      
  </div>
</div>

<% if group.is_owned_by?(current_user) || group.includes_user?(current_user) %>
  <div class="card shadow-sm border-0 p-4" style="background-color: #fcfaf2;">
    <h6 class="fw-bold text-center mb-3" style="color: #4a463f;">コミュニティに投稿</h6>
    <%= form_with model: @post, local: true do |f| %>
      <%= f.hidden_field :group_id, value: group.id %>
      
      <div class="form-group mb-2">
        <%= f.label :title, "タイトル", class: "x-small fw-bold text-secondary" %>
        <%= f.text_field :title, class: "form-control form-control-sm" %>
        <% if @post.errors.include?(:title) %>
          <div class="text-danger small mt-1 fw-bold">
            <i class="fa-solid fa-circle-exclamation"></i>
            <%= @post.errors.full_messages_for(:title).first %>
          </div>
        <% end %>      
      </div>

      <div class="form-group mb-3">
        <%= f.label :body, "本文", class: "x-small fw-bold text-secondary" %>
        <%= f.text_area :body, class: "form-control form-control-sm", rows: 3 %>
        <% if @post.errors.include?(:body) %> 
            <div class="text-danger small mt-1 fw-bold">
              <i class="fa-solid fa-circle-exclamation"></i>
              <%= @post.errors.full_messages_for(:body).first %>
          </div>
        <% end %>
      </div>

      <div class="text-center">
        <%= f.submit "投稿する", class: "w-100" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="card border-0 mt-4" style="background-color: #fcfaf2;">
  <div class="card-body">
  <h6 class="fw-bold text-center mb-3" style="color: #4a463f;">参加メンバー (<%= group.group_users.count %>人)</h6>
    
    
    <div class="member-list row">
      <% group.users.each do |user| %>
        <div class="d-flex align-items-center mb-3 col-md-6">
          <%= link_to admin_user_path(user), class: "text-decoration-none d-flex align-items-center" do %>
            <%= image_tag user.get_profile_image(35,35), size: "35x35", class: "rounded-circle border mr-2" %>
            <span class="small font-weight-bold text-dark">
              <%= user.nickname %>
            </span>
          <% end %>
        </div>
      <% end %>

      <% if group.users.empty? %>
        <p class="small text-muted">メンバーはいません</p>
      <% end %>
    </div>
  </div>
</div>
  