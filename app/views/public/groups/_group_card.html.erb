<div class="d-flex align-items-center mb-3">
  <%= image_tag group.get_group_image(100,100), size: "50x50", class: "rounded-circle border me-3" %>
  <span class="fw-bold ml-2"><%= group.name %></span>
</div>

<%= link_to group_path(group), class: "text-decoration-none text-dark d-block mb-3" do %>
  <div class="text-muted small" style="min-height: 3em;">
    <%= truncate(group.introduction, length: 60) %>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3 small text-secondary">
  <span><%= group.created_at.strftime('%Y/%m/%d') %></span>
  <div id="groups_btn_<%= group.id %>">
    <%= render 'public/groups/btn', group: group %>
  </div>
</div>