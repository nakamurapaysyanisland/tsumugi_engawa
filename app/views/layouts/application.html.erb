<!DOCTYPE html>
<html>
  
  <head>
    <title>つむぎ縁側</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://kit.fontawesome.com/157db97ebd.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%# app/views/layouts/application.html.erb %>
    <link href="https://fonts.googleapis.com" rel="stylesheet">

  </head>

  <body class="d-flex flex-column vh-100">
      <header class="navbar navbar-expand-lg navbar-light shadow-sm" style="background-color: #FFFDD0;">
        <nav class="container d-flex flex-row justify-content-between align-items-center">
           <a class="navbar-brand h1 mb-0 text-decoration-none text-dark" href="/">つむぎ縁側</a>
           <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown"
                aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
             <span class="navbar-toggler-icon"></span>
           </button>
          <div id="navbarNav">
          
            <ul class="d-flex list-unstyled mb-0 align-item-center">
              <% if user_signed_in? %>
                <li class="nav-item">
                  <%= link_to user_path(current_user), class: "text-dark mr-2" do %>
                    ホーム
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to user_path(current_user), class: "text-dark" do %>
                    投稿一覧
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to user_path(current_user), class: "text-dark" do %>
                    カテゴリー
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to user_path(current_user), class: "text-dark" do %>
                    新規投稿
                  <% end %>
                </li>
                <li class="nav-item">
                <%= link_to destroy_user_session_path, method: :delete, class: "text-dark" do %>
                  ログアウト
                <% end %>
              </li>
              <li class="nav-item">
                  <%= link_to user_path(current_user), class: "text-dark mr-4" do %>
                    <i class="fa-solid fa-bell"></i>
                  <% end %>
                </li>
              <% else %>
                <li class="nav-item">
                  <%= link_to root_path, class:"text-dark mr-4" do %>
                    ホーム
                  <% end %>
                  <li class="nav-item">
                  <%= link_to root_path, class: "text-dark mr-4" do %>
                    投稿一覧
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to root_path, class: "text-dark mr-4" do %>
                    カテゴリー
                  <% end %>
                </li>
                  <li class="nav-item">
                <%= link_to new_user_registration_path, class: "text-dark mr-4" do %>
                  新規会員登録
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_user_session_path, class: "text-dark mr-4" do %>
                  ログイン
                <% end %>
              </li>
            <% end %>  
            </ul>
            
           </div>
          
        </nav>
      </header>
    <%= yield %>
    <footer>
      <div>
        <p>CopyRight</p>
      </div>
    </footer>
  </body>
</html>
