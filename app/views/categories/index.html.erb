 <div class="container">
  <div class="row">
    <div class="col-md-12 col-sm-10 mx-2 shadow-lg rounded px-0 my-5">
      <div class="p-4 d-flex justify-content-center mb-4">
        <%= render 'searches/form', posts: @posts %>
      </div>



  <div class="categories-list">
 
 
<div class="row g-3 d-flex justify-content-center p-3"> 
<% @categories.each do |category| %>
    <div class="col-6 col-md-4 mb-3 "> 
      
      <%= link_to category_path(category), class: "text-decoration-none h-100 d-block" do %>
        
        <div class="p-3 shadow-sm rounded border text-center bg-white h-100 mb-3">
          <div class="category-name h5 text-dark mb-0">
            <%= category.name %>
          </div>
        </div>
        
      <% end %>
      
    </div>
  <% end %>
</div>
    
  </div>
</div>