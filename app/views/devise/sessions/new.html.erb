<div class="container">
<div class="row justify-content-center mt-4">
<div class="col-md-4 col-sm-12">
<div class="d-flex flex-column align-items-center justify-content-center w-100">
<h2 class="fw-bold" style="color: #4a463f;">おかえりなさい</h2>
 <%= render "devise/shared/error_messages", resource: resource %>
<%= form_with model: @user, local: true, class: "w-100" do |f| %>
  <div class="field mt-4 mb-1">
    <%= f.label :email, style: "color: #4a463f;" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
  </div>

  <div class="field my-1">
    <%= f.label :password, style: "color: #4a463f;" %><br />
    <%= f.password_field :password, autocomplete: "current-password",class: "form-control" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field", style: "color: #4a463f;">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>
  </div>
  <% end %>

  <div class="actions", style: "color: #4a463f;">
    <%= f.submit "ログイン", class: "w-100" %>
  </div>
<% end %>

<div class="mt-3">
<%= render "devise/shared/links" %>
</div>
</div>
</div>
</div>
</div>