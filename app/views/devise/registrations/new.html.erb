<h2>新規会員登録</h2>

<%= form_with model: @user, url: user_registration_path do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  
  <div class="d-flex flex-row">
    <div class="col">
      <%= f.file_field :image, accept: "image/*" %>
    </div>
      
    <div class="col">
      <%= f.label :姓 %><br />
      <%= f.text_field :last_name, autofocus: true, autocomplete: "last_name" %>
    </div>

    <div class="col">
      <%= f.label :名 %><br />
      <%= f.text_field :first_name, autocomplete: "first_name" %>
    </div>
  </div>
  
  <div class="field">
    <%= f.label :ニックネーム %><br />
    <%= f.text_field :nickname, autocomplete: "nickname" %>
  </div>

  <div class="field">
    <%= f.label :メールアドレス %><br />
    <%= f.email_field :email, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :パスワード %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> 文字以上)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :パスワード（確認用） %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="actions">
    <%= f.submit "登録する" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

<h3>ニックネームだけでゲスト登録</h3>
<%= form_with model: User.new, url: users_guest_sign_up_path, local: true do |f| %>
  <div class="field">
    <%= f.label :nickname %><br />
    <%= f.text_field :nickname, placeholder: "たろう" %>
  </div>
  <%= f.submit "ゲスト登録して始める" %>
<% end %>