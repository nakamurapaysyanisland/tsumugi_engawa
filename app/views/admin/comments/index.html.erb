<h4>コメント一覧</h4>

<table>
<thead>
<th>ユーザー名</th>
<th>コメント</th>
<th>コメント日時</th>
<th></th>
<th></th>
</thead>

<tbody>
<% @user.each do |user| %>
<tr>
<td><% user.nickname %></td>
<td><% user.comment %></td>
<td><% user.create_at %></td>
<td><% link_to '投稿を見る', admin_post_path(@user) %></td>
<td><% link_to '削除', admin_comments_index_path, method: :destroy, confirm: '本当に削除しますか？' %></td>
</tr>
</tbody>
</table>