<div class="container my-5">
  <div class="row justify-content-center">
   <div class="col-md-8 text-center">
      <h2 class="fw-bold mb-4" style="color: #4a463f;">- 投稿詳細(管理者用) -</h2>
      <div class="card shadow-sm border-0 p-4 mb-4" style="background-color: #fcfaf2;">
        <%= render 'admin/posts/post_card', post: @post %>

        <div class="mt-4 pt-4" style="border-top: 3px double #868e96;">

          <div id="comment_index_<%= @post.id %>">
            <%= render 'admin/post_comments/index', post: @post %>
          </div>
        </div>

        
        <div class="d-flex justify-content-end mt-4">
          <%= link_to '一覧へ', admin_post_comments_path, class: "btn btn-outline-secondary btn-sm" %>
        </div>
      </div>

    </div>
  </div>
</div>