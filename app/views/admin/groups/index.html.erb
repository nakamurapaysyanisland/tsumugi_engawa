<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-12 col-sm-11">
            <div class="d-flex flex-column align-items-center justify-content-center w-100">
                <h2 class="fw-bold mb-4" style="color: #4a463f;">- グループ一覧 -</h2>
                    <table class="table table-bordered table-hover text-center" style="background-color: #fcfaf2;">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>グループ名</th>
                                <th>オーナーID</th>
                                <th>オーナー名</th>
                                <th>参加人数</th>
                                <th>登録日</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @groups.each do |group| %>
                                <tr>
                                    <td width="5%" class="text-center align-middle"><%= group.id %></td>
                                    <td width="30%" class="text-center align-middle"><%= group.name %></td>
                                    <td width="10%" class="text-center align-middle"><%= group.owner_id %></td>
                                    <td width="15%" class="text-center align-middle"><%= group.owner.nickname %></td>
                                    <td width="10%" class="text-center align-middle"><%= group.users.count %>人</td>
                                    <td width="15%" class="text-center align-middle"><%= group.created_at.strftime('%Y/%m/%d') %></td>
                                    <td width="15%" class="text-center align-middle">
                                        <%= link_to '詳細', admin_group_path(group), class: "btn btn-sm btn-outline-success text-success" %> |
                                        <%= link_to '削除', admin_group_path(group), method: :delete, data: { confirm: '本当に削除しますか？' }, class: "btn btn-sm btn-outline-danger text-danger" %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                <div class="d-flex justify-content-center mt-4">
                    <%= paginate @groups %>
                </div>
            </div>
        </div>
    </div>
</div>