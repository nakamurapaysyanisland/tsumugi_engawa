<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-12 col-sm-11">
            <div class="d-flex flex-column align-items-center justify-content-center w-100">
                <h2 class="fw-bold mb-3" style="color: #4a463f;">- コメント一覧 -</h2>
                    <table class="table table-bordered table-hover text-center" style="background-color: #fcfaf2;">
                        <thead>
                            <tr>
                                <th>ユーザー名</th>
                                <th>コメントID</th>
                                <th>コメント</th>
                                <th>登録日</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @post_comment.each do |post_comment| %>
                                <tr>
                                    <td width="15%" class="text-center align-middle"><%= post_comment.user.nickname %></td>
                                    <td width="10%" class="text-center align-middle"><%= post_comment.id %></td>
                                    <td width="50%" class="text-center align-middle"><%= truncate(post_comment.content, length: 30) %></td>
                                    <td width="10%" class="text-center align-middle"><%= post_comment.created_at.strftime('%Y/%m/%d') %></td>
                                    <td width="10%" class="text-center align-middle">
                                       <%= link_to '詳細', admin_post_path(post_comment.post), class: "btn btn-sm btn-outline-success text-success" %> |
                                       <%= link_to '削除', admin_post_comment_path(post_comment), method: :delete, data: { confirm: '本当に削除しますか？' }, class: "btn btn-sm btn-outline-danger text-danger" %>   
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                <div class="d-flex justify-content-center mt-4">
                    <%= paginate @post_comment %>
                </div>
            </div>
        </div>
    </div>
</div>







