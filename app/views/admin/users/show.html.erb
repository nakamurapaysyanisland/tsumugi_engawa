<div class="container my-5">
  <div class="row justify-content-center mb-4">
    <div class="col-md-12 col-lg-8">
      <div class="px-4 pt-4 pb-4 rounded border-bottom text-center">
        <div class="mb-3">
          <%= image_tag @user.get_profile_image(100,100), size: "100x100", class: "rounded-circle border" %>
        </div>
        <h4 class="fw-bold"><%= @user.nickname %>さん</h4>
          <div class="d-flex justify-content-center my-4 text-secondary">
            <div class="d-flex flex-column text-left mr-5">
              <div class="mb-2">
                <strong>氏名：</strong><%= @user.last_name %><%= @user.first_name %>
              </div>
              <div class="mb-2">
                <strong>メールアドレス：</strong><%= @user.email %>
              </div>
              <div>
                <strong>ステータス：</strong><%= t(@user.role, scope: 'enums.user.role') %>
              </div>
            </div>
            <div class="d-flex flex-column text-left">
              <div class="mb-2">
                <strong>登録日：</strong><%= @user.created_at.strftime('%Y年%m月%d日') %>
              </div>
              <div class="mb-2">
                <strong>更新日：</strong><%= @user.updated_at.strftime('%Y年%m月%d日') %>
              </div>
              <div>
                <strong>投稿数：</strong><%= @user.posts.count %>件
              </div>
            </div>
          </div>
          <%= link_to 'ユーザー一覧に戻る', admin_dashboards_path, class: "btn btn-sm btn-outline-dark" %> |
          <%= link_to '退会', withdraw_admin_user_path(@user), method: :patch, data: { confirm: "本当に退会しますか？" }, class: "btn btn-sm btn-outline-danger text-danger" %>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12 text-center">
      <h4 class="fw-bold" style="color: #4a463f;">投稿一覧</h4>
    </div>
  </div>

  <div class="row mt-2">
    <% @posts.each do |post| %>
      <div id="post_<%= post.id %>" class="col-md-4 mb-2">
        <div class="rounded border h-100 p-4 d-flex flex-column" style="background-color: #fcfaf2;">
          <%= render 'admin/posts/post_card', post: post %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-5">
    <%= paginate @posts %>
  </div>
</div>