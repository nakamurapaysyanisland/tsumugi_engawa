<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-12 col-sm-11">
            <div class="d-flex flex-column align-items-center justify-content-center w-100">
                <h2 class="fw-bold mb-4" style="color: #4a463f;">- ユーザー一覧 -</h2>
                    <table class="table table-bordered table-hover text-center" style="background-color: #fcfaf2;">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>名前</th>
                                <th>ユーザー名</th>
                                <th>メールアドレス</th>
                                <th>会員<br>ランク</th>
                                <th>会員<br>状況</th>
                                <th>登録日</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @users.each do |user| %>
                                <tr>
                                    <td width="5%" class="text-center align-middle"><%= user.id %></td>
                                    <td width="20%" class="text-center align-middle">
                                        <%= user.last_name %>
                                        <%= user.first_name %>
                                    </td>
                                    <td width="20%" class="text-center align-middle"><%= user.nickname %></td>
                                    <td width="15%" class="text-center align-middle"><%= user.email %></td>
                                    <td width="10%" class="text-center align-middle"><%= t(user.role, scope: 'enums.user.role') %></td>
                                    <td width="10%" class="text-center align-middle"><%= t(user.status, scope: 'enums.user.status') %></td>
                                    <td width="15%" class="text-center align-middle"><%= user.created_at.strftime('%Y/%m/%d') %></td>
                                    <td width="5%">
                                        <%= link_to '詳細', admin_user_path(user), class: "text-success" %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                <div class="d-flex justify-content-center mt-4">
                    <%= paginate @users %>
                </div>
            </div>
        </div>
    </div>
</div>
